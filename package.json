{
	"name": "home",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"init": "husky install && bun install",
		"setup": "bun meta/scripts/setup.ts",
		"dev": "bun run setup && bun x --bun vite dev --host",
		"build": "bun run setup && bun x --bun vite build && bun run prepare",
		"prepare": "svelte-kit sync",
		"fmt": "bun x prettier --write . && bun x eslint . --fix",
		"lint": "bun x prettier --check . && bun x eslint ."
	},
	"devDependencies": {
		"@castlenine/svelte-qrcode": "^2.3.0",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.15.1",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/bun": "latest",
		"@types/node": "^24",
		"@types/ua-parser-js": "^0.7.39",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1"
	},
	"lint-staged": {
		"**/*.{js,ts,svelte,json,css}": [
			"bun x prettier --write",
			"bun x eslint . --fix"
		]
	},
	"dependencies": {
		"@davidnet-net/svelte-ui": "^2.0.66",
		"@types/country-list": "^2.1.4",
		"@vanilla-extract/css": "^1.18.0",
		"@vanilla-extract/recipes": "^0.5.7",
		"@vanilla-extract/vite-plugin": "^5.1.4",
		"country-list": "^2.4.1",
		"svelte-confetti": "^2.0.0",
		"ua-parser-js": "^2.0.10"
	}
}